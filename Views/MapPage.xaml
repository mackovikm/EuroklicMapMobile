<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:EuroklicMapMobile.ViewModels"
             x:Class="EuroklicMapMobile.Views.MapPage"
             x:DataType="vm:MapViewModel"
             Title="EuroklicMap">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Obnovit"
                     IconImageSource="ic_refresh.png"
                     Command="{Binding RefreshCommand}"
                     Order="Primary"
                     Priority="0" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="*, Auto">

        <!-- Mapa (Leaflet pres WebView) -->
        <WebView x:Name="MapWebView"
                 Grid.Row="0"
                 Navigated="OnMapNavigated" />

        <!-- Spodni stavovy pruh -->
        <Grid Grid.Row="1"
              BackgroundColor="{StaticResource Primary}"
              Padding="12,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Label Grid.Column="0"
                   Text="{Binding StatusText}"
                   TextColor="White"
                   FontSize="12"
                   VerticalOptions="Center"
                   LineBreakMode="TailTruncation" />

            <Label Grid.Column="1"
                   Text="{Binding PointCountText}"
                   TextColor="#B3E5FC"
                   FontSize="12"
                   FontAttributes="Bold"
                   VerticalOptions="Center" />
        </Grid>

        <!-- Ukazatel nacitani -->
        <Grid Grid.Row="0"
              IsVisible="{Binding IsBusy}"
              BackgroundColor="#80000000">
            <VerticalStackLayout VerticalOptions="Center"
                                 HorizontalOptions="Center"
                                 Spacing="12">
                <ActivityIndicator IsRunning="True"
                                   Color="White"
                                   WidthRequest="48"
                                   HeightRequest="48" />
                <Label Text="Stahuji data..."
                       TextColor="White"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Grid>

    </Grid>
</ContentPage>
