<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:EuroklicMapMobile.ViewModels"
             xmlns:models="clr-namespace:EuroklicMapMobile.Models"
             x:Class="EuroklicMapMobile.Views.MapPage"
             x:DataType="vm:MapViewModel"
             Title="Euroklíč — mapa míst"
             BackgroundColor="White">

    <ContentPage.ToolbarItems>
        <ToolbarItem IconImageSource="ic_gps.png"
                     Clicked="OnGpsClicked"
                     Order="Primary" Priority="0" />
        <ToolbarItem IconImageSource="ic_refresh.png"
                     Command="{Binding RefreshCommand}"
                     Order="Primary" Priority="1" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">

        <!-- ── Řádek 0: Vyhledávání + tlačítko Hledat ───────────────────── -->
        <Grid Grid.Row="0"
              BackgroundColor="White"
              ColumnDefinitions="*,Auto"
              Padding="8,6,8,4"
              ColumnSpacing="6">

            <!-- Vstupní pole s tlačítkem ✕ -->
            <Border Grid.Column="0"
                    Stroke="#DEDEDE"
                    StrokeThickness="1"
                    BackgroundColor="#F5F5F5"
                    HeightRequest="38"
                    Padding="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <Grid ColumnDefinitions="*,Auto">
                    <Entry Grid.Column="0"
                           x:Name="SearchEntry"
                           Placeholder="Hledat (název, popis nebo adresu)..."
                           PlaceholderColor="#9E9E9E"
                           TextColor="#1A1A1A"
                           Text="{Binding SearchText}"
                           TextChanged="OnSearchTextChanged"
                           ReturnType="Search"
                           Completed="OnSearchCompleted"
                           BackgroundColor="Transparent"
                           VerticalOptions="Center"
                           FontSize="13"
                           Margin="10,0,0,0" />
                    <Button Grid.Column="1"
                            Text="✕"
                            IsVisible="{Binding SearchText, Converter={StaticResource StringNotEmptyConverter}}"
                            Clicked="OnClearSearchClicked"
                            BackgroundColor="Transparent"
                            TextColor="#9E9E9E"
                            FontSize="13"
                            WidthRequest="36"
                            HeightRequest="38"
                            Padding="0" />
                </Grid>
            </Border>

            <!-- Tlačítko Hledat -->
            <Button Grid.Column="1"
                    Text="Hledat"
                    Clicked="OnSearchButtonPressed"
                    FontSize="13"
                    HeightRequest="38"
                    Padding="12,0"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="White" />
        </Grid>

        <!-- ── Řádek 1: Horizontálně rolovatelné chipy typů ───────────── -->
        <ScrollView Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalScrollBarVisibility="Never"
                    BackgroundColor="#F0F4F8"
                    MinimumHeightRequest="46">
            <HorizontalStackLayout x:Name="ChipsLayout"
                                   Padding="8,6"
                                   Spacing="6" />
        </ScrollView>

        <!-- ── Řádek 2: Mapa ──────────────────────────────────────────── -->
        <WebView x:Name="MapWebView"
                 Grid.Row="2"
                 Navigating="OnMapNavigating"
                 Navigated="OnMapNavigated" />

        <!-- Spinner načítání (překrývá mapu) -->
        <Grid Grid.Row="2"
              IsVisible="{Binding IsBusy}"
              BackgroundColor="#99FFFFFF"
              ZIndex="10">
            <VerticalStackLayout VerticalOptions="Center"
                                 HorizontalOptions="Center"
                                 Spacing="14">
                <ActivityIndicator IsRunning="True"
                                   Color="{StaticResource Primary}"
                                   WidthRequest="48" HeightRequest="48" />
                <Label Text="Stahuji data..."
                       TextColor="{StaticResource Primary}"
                       FontAttributes="Bold"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Grid>

        <!-- ── Řádek 4: Stavový řádek ─────────────────────────────────── -->
        <Grid Grid.Row="4"
              BackgroundColor="{StaticResource Primary}"
              Padding="12,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Label Grid.Column="0"
                   Text="{Binding StatusText}"
                   TextColor="White" FontSize="11"
                   VerticalOptions="Center"
                   LineBreakMode="TailTruncation" />
            <Label Grid.Column="1"
                   Text="{Binding PointCountText}"
                   TextColor="#B3E5FC" FontSize="11" FontAttributes="Bold"
                   VerticalOptions="Center" />
        </Grid>

        <!-- ── Řádek 3: Spodní panel „Body a legenda" ──────────────────── -->
        <Grid Grid.Row="3" RowDefinitions="Auto,Auto" BackgroundColor="White">

            <!-- Záhlaví panelu (klikací) -->
            <Grid Grid.Row="0" BackgroundColor="#F0F4F8" Padding="12,9">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnTogglePanelTapped" />
                </Grid.GestureRecognizers>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0"
                       FontSize="13" FontAttributes="Bold" TextColor="#1A1A2E"
                       VerticalOptions="Center">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="Legenda typů — seznam bodů  " />
                            <Span Text="{Binding VisibleCountText}"
                                  TextColor="{StaticResource Primary}"
                                  FontAttributes="Bold" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
                <Label x:Name="PanelArrow"
                       Grid.Column="1"
                       Text="▲" FontSize="14"
                       TextColor="{StaticResource Primary}"
                       VerticalOptions="Center" />
            </Grid>

            <!-- Seznam bodů (collapsible) -->
            <CollectionView Grid.Row="1"
                            ItemsSource="{Binding VisiblePoints}"
                            IsVisible="{Binding IsPanelExpanded}"
                            HeightRequest="260"
                            BackgroundColor="White"
                            SelectionMode="Single"
                            SelectionChanged="OnPointSelected">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:EuroklicPoint">
                        <Grid Padding="10,8,12,8" ColumnDefinitions="36,10,*"
                              RowDefinitions="Auto">

                            <!-- Barevný kruh s emoji ikonou -->
                            <Border Grid.Column="0"
                                    WidthRequest="32" HeightRequest="32"
                                    StrokeThickness="0"
                                    VerticalOptions="Start" Margin="0,2,0,0"
                                    BackgroundColor="{Binding Type, Converter={StaticResource TypeColorConverter}}">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>
                                <Label Text="{Binding Type, Converter={StaticResource TypeIconConverter}}"
                                       FontSize="15"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>

                            <!-- Textový obsah – vnořený Grid se zarovnaným sloupcem ikon -->
                            <Grid Grid.Column="2"
                                  ColumnDefinitions="16,*"
                                  RowDefinitions="Auto,Auto,Auto,Auto"
                                  RowSpacing="1">

                                <!-- Název (přes oba sloupce) -->
                                <Label Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="0"
                                       Text="{Binding Name}"
                                       FontAttributes="Bold" FontSize="14" TextColor="#1A1A1A"
                                       LineBreakMode="TailTruncation" />

                                <!-- Ikona vzdálenosti -->
                                <Image Grid.Column="0" Grid.Row="1"
                                       Source="ic_ruler.svg"
                                       WidthRequest="12" HeightRequest="12"
                                       IsVisible="{Binding HasDistance}"
                                       VerticalOptions="Center" HorizontalOptions="Start" />
                                <!-- Vzdálenost + typ -->
                                <HorizontalStackLayout Grid.Column="1" Grid.Row="1"
                                                       Spacing="6" VerticalOptions="Center">
                                    <Label Text="{Binding DistanceText}"
                                           IsVisible="{Binding HasDistance}"
                                           FontSize="11" TextColor="#1d4ed8" FontAttributes="Bold"
                                           VerticalOptions="Center" />
                                    <Label Text="{Binding Type, Converter={StaticResource TypeLabelConverter}}"
                                           FontSize="11" TextColor="#777777"
                                           CharacterSpacing="0.3" TextTransform="Uppercase"
                                           VerticalOptions="Center" />
                                </HorizontalStackLayout>

                                <!-- Ikona adresy -->
                                <Label Grid.Column="0" Grid.Row="2"
                                       Text="📍"
                                       FontSize="11"
                                       IsVisible="{Binding Address, Converter={StaticResource StringNotEmptyConverter}}"
                                       VerticalOptions="Center" />
                                <!-- Adresa -->
                                <Label Grid.Column="1" Grid.Row="2"
                                       Text="{Binding Address}"
                                       FontSize="12" TextColor="#444444"
                                       IsVisible="{Binding Address, Converter={StaticResource StringNotEmptyConverter}}"
                                       LineBreakMode="TailTruncation"
                                       StyleClass="CopyOnLongPress"
                                       VerticalOptions="Center" />

                                <!-- Ikona souřadnic -->
                                <Image Grid.Column="0" Grid.Row="3"
                                       Source="ic_mappin.svg"
                                       WidthRequest="10" HeightRequest="10"
                                       VerticalOptions="Center" HorizontalOptions="Start" />
                                <!-- Souřadnice -->
                                <Label Grid.Column="1" Grid.Row="3"
                                       Text="{Binding CoordinatesText}"
                                       FontSize="10" TextColor="#999999"
                                       FontFamily="Monospace"
                                       StyleClass="CopyOnLongPress"
                                       VerticalOptions="Center" />

                            </Grid>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="0" />
                </CollectionView.ItemsLayout>
            </CollectionView>

        </Grid>
    </Grid>
</ContentPage>
